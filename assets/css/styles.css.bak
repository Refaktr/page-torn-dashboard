:root {
    color-scheme: dark;
    --bg: #101418;
    --bg-soft: #151b22;
    --panel: rgba(20, 26, 33, 0.92);
    --panel-border: rgba(255, 255, 255, 0.08);
    --panel-strong: rgba(255, 255, 255, 0.04);
    --text: #ecf3f9;
    --muted: #9fb0bf;
    --accent: #5ac8fa;
    --accent-strong: #84dcff;
    --good: #46cc71;
    --bad: #e74c3c;
    --warn: #f3a81f;
    --blue: #4ea3ff;
    --yellow: #f4d03f;
    --shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
}

* {
    box-sizing: border-box;
}

html,
body {
    margin: 0;
    min-height: 100%;
}

body {
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: var(--text);
    background:
        radial-gradient(circle at top left, rgba(90, 200, 250, 0.18), transparent 30%),
        radial-gradient(circle at top right, rgba(70, 204, 113, 0.1), transparent 24%),
        linear-gradient(180deg, #0c1014 0%, #111820 100%);
}

body::before {
    content: "";
    position: fixed;
    inset: 0;
    background-image: linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 36px 36px;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.8), transparent 90%);
    pointer-events: none;
}

.container {
    width: min(1440px, calc(100% - 24px));
    margin: 0 auto;
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 18px;
    min-height: 100vh;
    padding: 20px 0 32px;
    position: relative;
}

.sidebar {
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-radius: 22px;
    box-shadow: var(--shadow);
    backdrop-filter: blur(20px);
    padding: 20px 16px;
    align-self: start;
    position: sticky;
    top: 16px;
}

.sidebar h2 {
    margin: 0 0 18px;
    padding: 8px 10px;
    font-size: 1.1rem;
    letter-spacing: 0.04em;
    color: var(--text);
}

.sidebar a {
    display: block;
    padding: 12px 12px;
    margin-bottom: 8px;
    color: var(--muted);
    text-decoration: none;
    border-radius: 12px;
    border: 1px solid transparent;
    font-weight: 600;
    transition: background 0.18s ease, border-color 0.18s ease, color 0.18s ease, transform 0.18s ease;
}

.sidebar a:hover,
.sidebar a.is-active {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.06);
    color: var(--text);
    transform: translateX(2px);
}

.content {
    flex: 1;
    padding: 4px 0 0;
    overflow: auto;
    display: grid;
    gap: 14px;
    align-content: start;
}

.header {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    margin-bottom: 2px;
}

.header h1 {
    margin: 0;
    font-size: clamp(2.2rem, 3vw, 3.5rem);
    line-height: 0.92;
    letter-spacing: -0.06em;
}

.header > span {
    color: var(--muted);
    font-size: 0.96rem;
}

.cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 18px;
}

.card--wide {
    grid-column: span 2;
}

.card,
.page-placeholder,
.api-call-ticker,
.page-faction .faction-hero,
.page-faction .faction-controls,
.page-faction .faction-status-strip,
.page-faction .faction-table-panel {
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-radius: 20px;
    box-shadow: var(--shadow);
    backdrop-filter: blur(20px);
}

.card {
    padding: 20px 20px 18px;
}

.card h3,
.faction-label,
.page-faction .faction-hero-card-label,
.page-faction .faction-form-grid label span,
.page-faction .faction-message {
    color: var(--muted);
    font-size: 0.82rem;
    letter-spacing: 0.03em;
}

.card h3 {
    margin: 0 0 10px;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
}

.value {
    font-size: clamp(1rem, 1.5vw, 2rem);
    font-weight: 800;
    color: var(--accent-strong);
    letter-spacing: -0.04em;
    overflow-wrap: anywhere;
    word-break: break-word;
}

.page-placeholder {
    width: min(100%, 720px);
    max-width: none;
    padding: 24px;
    line-height: 1.6;
    color: var(--text);
}

.api-call-ticker {
    width: 100%;
    margin-bottom: 18px;
    padding: 14px 16px;
    font-size: 13px;
    background: rgba(255, 255, 255, 0.03);
}

.api-call-ticker-title {
    font-weight: 700;
    color: var(--text);
    margin-bottom: 6px;
}

.api-call-ticker-count {
    color: var(--accent-strong);
    font-weight: 700;
    margin-bottom: 4px;
}

.api-call-ticker-window,
.api-call-ticker-reset {
    color: var(--muted);
    font-size: 12px;
}

.primary,
.secondary {
    border: 0;
    border-radius: 14px;
    padding: 13px 18px;
    cursor: pointer;
    transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
}

.primary {
    color: #07121a;
    background: linear-gradient(135deg, var(--accent), var(--accent-strong));
    box-shadow: 0 14px 28px rgba(90, 200, 250, 0.22);
    font-weight: 700;
}

.secondary {
    color: var(--text);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
}

.primary:hover,
.secondary:hover {
    transform: translateY(-1px);
}

@media (max-width: 900px) {
    .container {
        grid-template-columns: 1fr;
        min-height: auto;
        width: min(100% - 20px, 1220px);
    }

    .sidebar {
        position: static;
    }

    .content {
        overflow: visible;
    }

    .cards {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .card--wide {
        grid-column: span 2;
    }
}

@media (max-width: 640px) {
    .container {
        width: min(100% - 20px, 1220px);
        padding-top: 18px;
    }

    .cards {
        grid-template-columns: 1fr;
    }

    .card--wide {
        grid-column: auto;
    }

    .header {
        flex-direction: column;
        align-items: flex-start;
    }
}
